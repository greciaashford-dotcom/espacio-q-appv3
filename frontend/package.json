{
  "name": "espacio-q-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "postbuild": "node scripts/ensure-build.mjs --stamp",
    "prestart": "node scripts/ensure-build.mjs",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:gen": "node scripts/gen-db-schema.mjs",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "admin:create": "tsx --env-file=.env prisma/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:dev": "next dev -H 0.0.0.0 -p 3000"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "date-fns-tz": "3.2.0",
    "exceljs": "4.4.0",
    "framer-motion": "11.15.0",
    "image-size": "1.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "0.469.0",
    "mongodb": "6",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.2",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "20.17.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
